        <ui:VisualElement name="Options" style="flex-grow: 0; margin-top: 5%; margin-right: 0; margin-bottom: 0%; margin-left: 4px; padding-top: 5%; padding-bottom: 5%; padding-left: 0; aspect-ratio: 3; width: 100%; justify-content: flex-end;">
            <ui:Button text="" name="Options" class="resume-option-button" style="background-color: rgba(188, 188, 188, 0); margin-bottom: 0; margin-right: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: center; margin-top: 0; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
